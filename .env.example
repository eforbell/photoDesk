IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=your-api-key-here
PORT=3400
TZ=America/New_York
# Optional: exclude older imported photos from PhotoDesk discovery and un-triaged counts.
# PHOTODESK_LIBRARY_START_DATE=2024-01-01
PHOTODESK_EDIT_DIR=/data/apps/photoDesk-data/edits
PHOTODESK_HEIC_DECODE=off
# External mode only. Leave unset to discover vips from PATH.
# PHOTODESK_HEIC_DECODER_CMD=/usr/bin/vips
# Containerized external decoder option for hosts with older libheif/libvips:
# PHOTODESK_HEIC_DECODER_CMD=/data/apps/photoDesk/scripts/photodesk-vips-docker
# PHOTODESK_HEIC_DECODER_IMAGE=photodesk-heic-decoder:trixie
